# --- Database ---
DATABASE_URL=postgres://octypo:octypo@localhost:5432/octypo

# --- LLM providers (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Language models (optional): a specialist model for one language ---
# Any OpenAI-compatible endpoint, hosted or local. Still set a provider above:
# it runs the helper steps and takes over if the language model fails.
# Leave out apiKeyEnv for a local server. Spend on these models is not priced.
# LANGUAGE_ENGINES_JSON='{"ja":{"baseURL":"https://host.example/v1","model":"model-name","apiKeyEnv":"JA_MODEL_KEY"}}'
# JA_MODEL_KEY=

# --- Daily limit on model spend, in USD ---
# OCTYPO_DAILY_COST_CAP_USD=5

# --- Server ---
PORT=3000

# --- Admin platform (leave empty to disable the /admin UI + admin API) ---
ADMIN_PASSWORD=

# --- Optional: site URL for IndexNow ping on publish ---
# SITE_URL=https://example.com

# --- Content domain (used to steer all prompts) ---
CONTENT_DOMAIN="general news and analysis"

# --- Pipeline tuning ---
RSS_INTERVAL_MINUTES=30
RSS_GLOBAL_DAILY_LIMIT=20
RSS_DAILY_LIMIT_PER_TOPIC=5
RSS_MIN_QUALITY_SCORE=70
ENABLE_RSS_SCHEDULER=true
ENABLE_GATEKEEPER_PIPELINE=true

# --- Document Library (second content source: upload files → articles) ---
LIBRARY_DAILY_LIMIT=3
LIBRARY_INTERVAL_MINUTES=30
ENABLE_LIBRARY_SCHEDULER=true

# --- Topics (JSON array; used for tagging + per-topic daily limits) ---
# TOPICS_JSON='[{"slug":"ai","name":"Artificial Intelligence","keywords":["ai","llm"]}]'

# --- Public path prefix for article URLs on the consuming site (JSON-LD + IndexNow) ---
ARTICLE_PATH_PREFIX=/guides

# --- Rank tracking: once a month, where every target phrase stands in Google ---
# On by default. Needs SITE_URL and the DataForSEO login; does nothing without them.
# One ranked_keywords call per month, about $0.10 at most.
ENABLE_RANK_TRACKING=true

# --- Autonomous growth plan: evidence-backed bank, replenished before it runs dry ---
# JSON array or comma/newline-separated seeds. Empty means visibly blocked; topics are never invented.
# GROWTH_SEEDS='["wedding cakes","custom birthday cakes","vegan bakery"]'
ENABLE_GROWTH_PLANNER=false
GROWTH_ARTICLES_PER_WEEK=2
GROWTH_PLANNING_WEEKS=26
GROWTH_RESERVE_WEEKS=6
GROWTH_CHECK_INTERVAL_HOURS=24
GROWTH_COUNTRY=US
GROWTH_LANGUAGE=en

# --- Site language: BCP 47 tag. Sets the text direction of what the engine renders ---
# SITE_LANGUAGE=en

# --- Client questionnaire at /q/<token> (needs a token of 16+ characters) ---
# INTAKE_TOKEN=
# English by default. For another language, replace the questions and the page text:
# INTAKE_QUESTIONS_JSON='[{"id":"money","title":"Pricing","questions":[{"id":"price","label":"Typical price?","fact":"Typical price","cluster":"*","type":"text"}]}]'
# INTAKE_COPY='{"title":"Content questionnaire","next":"Next"}'

# --- Astro/git target: site-specific words and routing (all optional) ---
# GITHUB_SITE_COPY='{"author":"Editorial team","sourceLabel":"Source"}'
# GITHUB_SITE_AREAS='{"hotels":{"category":"travel","hubHref":"/hotels/","hubTitle":"Hotels"}}'
# GITHUB_DEFAULT_CATEGORY=general

# --- Publishing: false = approved articles wait as drafts for manual publish ---
AUTO_PUBLISH=false

# --- Hero images (gpt-image-1 → R2 public bucket) ---
# When OPENAI_API_KEY + all R2 vars + R2_PUBLIC_BASE_URL are set and
# ENABLE_IMAGE_GENERATION is not disabled, every article ships with a
# brand-consistent hero illustration. Otherwise articles publish image-less.
ENABLE_IMAGE_GENERATION=true
# OPENAI_API_KEY=                 # (also used for LLM generation above)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=octypo-media
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Indexing: engine is closed/noindex; leave OFF (the consuming site owns indexing) ---
ENABLE_INDEXNOW=false

# --- Hero image backdrop (keeps engine neutral; set per brand/locale) ---
IMAGE_BACKDROP=a softly-lit city skyline at night

# --- Real search demand (optional; also powers the SEO desk below) ---
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_LOCATION_CODE=2840
# DATAFORSEO_LANGUAGE_CODE=en

# --- SEO desk: optional, needs your own DataForSEO account ---
# Opens the research bench in the admin (domain, keywords, backlinks,
# competitors, gap, live SERP), billed to the account set above.
# Unset, every /api/admin/seo route answers 404 and the sidebar hides it.
# SEO_TOOLS_ENABLED=1
# Which country the desk opens on. Separate from DATAFORSEO_LOCATION_CODE
# above, which is the engine's market.
# SEO_DESK_LOCATION_CODE=2840
# SEO_DESK_LANGUAGE_CODE=en

# Fallback language for the writer when a site sets none (ISO 639-1)
# OCTYPO_LOCALE=en
# Section headings written into articles, per site, as JSON
# SECTION_HEADINGS_JSON={"faq":"Frequently asked questions"}
