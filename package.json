{
  "name": "octypo",
  "version": "1.0.0",
  "description": "Autonomous content engine: turns feeds into fact-checked articles in any language.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KBRglobal/octypo-engine-oss.git"
  },
  "homepage": "https://github.com/KBRglobal/octypo-engine-oss#readme",
  "bugs": {
    "url": "https://github.com/KBRglobal/octypo-engine-oss/issues"
  },
  "keywords": [
    "content",
    "seo",
    "llm",
    "automation",
    "rss",
    "multilingual"
  ],
  "bin": {
    "octypo": "bin/octypo.mjs"
  },
  "files": [
    "bin",
    "dist",
    "dist-admin",
    "drizzle",
    "build-info.json",
    ".env.example",
    "docker-compose.yml",
    "API.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:admin": "npm --prefix admin run dev",
    "build": "node scripts/write-build-info.mjs && tsc && node scripts/copy-assets.mjs && npm --prefix admin run build",
    "check": "tsc --noEmit && tsc --noEmit -p blog/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepare": "node scripts/install-admin.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@aws-sdk/client-s3": "^3.1066.0",
    "@google/genai": "^1.33.0",
    "@types/multer": "^2.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "groq-sdk": "^0.37.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "nanoid": "^5.1.0",
    "openai": "^7.50.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "drizzle-kit": "^0.31.8",
    "playwright": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
