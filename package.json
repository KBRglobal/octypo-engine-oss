{
  "name": "octypo",
  "version": "1.0.1",
  "description": "Autonomous content engine: turns feeds into source-checked articles in any language.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KBRglobal/octypo-engine-oss.git"
  },
  "homepage": "https://github.com/KBRglobal/octypo-engine-oss#readme",
  "bugs": {
    "url": "https://github.com/KBRglobal/octypo-engine-oss/issues"
  },
  "keywords": [
    "content",
    "seo",
    "llm",
    "automation",
    "rss",
    "multilingual"
  ],
  "bin": {
    "octypo": "bin/octypo.mjs"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/__fixtures__",
    "dist-admin",
    "drizzle",
    "build-info.json",
    ".env.example",
    "docker-compose.yml",
    "API.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:admin": "npm --prefix admin run dev",
    "build": "node scripts/write-build-info.mjs && tsc && node scripts/copy-assets.mjs && npm --prefix admin run build",
    "check": "tsc --noEmit && tsc --noEmit -p blog/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepare": "node scripts/install-admin.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@google/genai": "^2.32.0",
    "@types/multer": "^2.3.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "mammoth": "^1.13.0",
    "multer": "^2.1.1",
    "nanoid": "^6.0.2",
    "openai": "^7.50.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^4.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "drizzle-kit": "^0.31.8",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
