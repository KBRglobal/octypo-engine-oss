---
import { resizedImageUrl, buildSrcset, HERO_INTRINSIC } from '../lib/images';

interface Props {
  src: string | null | undefined;
  alt: string | null | undefined;
  resizePrefix: string | null;
  sizes?: string;
  priority?: boolean;
}

const {
  src,
  alt,
  resizePrefix,
  sizes = '(max-width: 768px) calc(100vw - 2rem), 34vw',
  priority = false,
} = Astro.props;
const widths = [480, 720, 960];
const url = resizedImageUrl(src, { width: 720, prefix: resizePrefix });
const srcset = buildSrcset(src, widths, resizePrefix);
---

{
  url && (
    <img
      class="octypo-card-image"
      src={url}
      srcset={srcset || undefined}
      sizes={sizes}
      alt={alt ?? ''}
      width={HERO_INTRINSIC.width}
      height={HERO_INTRINSIC.height}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  )
}
